# systemd unit for the Show of Hands app server on the small-apps droplet.
# Install: cp to /etc/systemd/system/showhands-web.service, create
# /opt/showhands/app/.env (see env.example), then:
#   systemctl daemon-reload && systemctl enable --now showhands-web

[Unit]
Description=Show of Hands web (SvelteKit adapter-node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=showhands
Group=showhands
WorkingDirectory=/opt/showhands/app
EnvironmentFile=/opt/showhands/app/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node build/index.js
Restart=always
RestartSec=3

# Hardening. strict makes the whole filesystem read-only, including this
# checkout, so a compromised process cannot rewrite deploy/deploy.sh; the app
# only writes the SQLite files and secret.key under /opt/showhands/data.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/showhands/data
ProtectHome=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
