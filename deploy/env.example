# Copy to /opt/showhands/app/.env on the droplet (owner showhands, mode 600).
PORT=3002
ORIGIN=https://showhands.rexlorenzo.com
DATABASE_PATH=/opt/showhands/data/showhands.db
# Caddy fronts the app, so the socket peer is always 127.0.0.1. Without these
# every per-IP rate limit becomes one shared bucket; the app refuses to start.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Required, 32+ chars: openssl rand -hex 32. Set explicitly so device cookies
# and creator tokens survive even if the data directory is wiped (polls
# themselves are disposable by design). Shorter values are rejected at boot.
SHOWHANDS_SECRET=
