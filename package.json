{
	"name": "show-of-hands",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''; git config core.hooksPath .githooks || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vp test run",
		"test:unit": "vp test",
		"test:e2e": "playwright test",
		"lint": "vp lint && vp fmt --check",
		"format": "vp fmt",
		"analyze": "fallow",
		"analyze:gate": "fallow audit"
	},
	"dependencies": {
		"better-sqlite3": "^12.4.1",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.13.3",
		"@types/qrcode": "^1.5.5",
		"fallow": "^3.6.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true
	}
}
